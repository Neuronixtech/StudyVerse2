# StudyVerse API: local development settings.
# Copy to apps/api/.env (git-ignored) and replace every CHANGE_ME.
# Never commit real values. Staging and production use the deployment's secret store.
# URL-encode special characters in usernames and passwords.
# The roles and databases below are created by infra/postgres/init on first start.

# Runtime connection used by the API: least-privilege role, row reads and writes only.
DATABASE_URL="postgresql://studyverse_app:CHANGE_ME@127.0.0.1:5432/studyverse"

# Prisma CLI (migrations) only: the database owner role. The running API never uses it.
DATABASE_MIGRATION_URL="postgresql://studyverse_migrator:CHANGE_ME@127.0.0.1:5432/studyverse"

# Local `prisma migrate dev` only: scratch database Prisma uses to check migrations.
DATABASE_SHADOW_URL="postgresql://studyverse_migrator:CHANGE_ME@127.0.0.1:5432/studyverse_shadow"

# Integration tests. The database name must end in _test; the test setup refuses anything else.
TEST_DATABASE_URL="postgresql://studyverse_app:CHANGE_ME@127.0.0.1:5432/studyverse_test"
TEST_DATABASE_MIGRATION_URL="postgresql://studyverse_migrator:CHANGE_ME@127.0.0.1:5432/studyverse_test"
