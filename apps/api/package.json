{
  "name": "@studyverse/api",
  "version": "0.1.0",
  "private": true,
  "description": "StudyVerse backend API (NestJS modular monolith). See design/docs/Backend_architecture.md.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "oxlint --type-aware src test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "prisma:generate": "prisma generate",
    "db:validate": "prisma validate && prisma format --check",
    "db:format": "prisma format",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "12.6.0",
    "@nestjs/core": "12.6.0",
    "@nestjs/platform-express": "12.6.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.15",
    "@nestjs/schematics": "12.0.16",
    "@nestjs/testing": "12.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
