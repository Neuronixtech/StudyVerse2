# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth: the root app and apps/api each have their own)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/reports/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files hold secrets and are never committed; .env.example templates are the exception
.env*
!.env.example

# backend API (apps/api): build output, coverage and the generated Prisma client
/apps/api/dist/
/apps/api/coverage/
/apps/api/src/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
