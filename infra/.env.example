# Local Docker Compose settings. Copy to infra/.env (git-ignored) and set every value.
# Never commit real values.
#
# Use URL-safe random passwords: the API and migration containers put them inside
# postgresql:// URLs. Hex is safe; base64 is not (+, / and = need URL encoding).
#   openssl rand -hex 24

# Superuser of the local PostgreSQL container. Used only by the init script and for
# local administration; neither the API nor migrations use it.
POSTGRES_PASSWORD=CHANGE_ME

# Passwords for the roles the init script creates. Put the same values in the
# connection URLs in apps/api/.env.
STUDYVERSE_MIGRATOR_PASSWORD=CHANGE_ME
STUDYVERSE_APP_PASSWORD=CHANGE_ME

# Host ports, bound to 127.0.0.1 only. Change them if they're taken (and, for
# PostgreSQL, update the URLs in apps/api/.env to match).
POSTGRES_HOST_PORT=5432
API_HOST_PORT=3001

# Log level for the API container (--profile app).
API_LOG_LEVEL=info
