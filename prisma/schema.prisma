// -----------------------------------------------------------------------------
// IDENTITY, AUTHENTICATION AND AUTHORIZATION
// -----------------------------------------------------------------------------

// Accounts are never hard-deleted by the application. Closing an account sets
// status DEACTIVATED and deactivatedAt: sign-in stops, sessions are revoked, and
// exam attempts, subscriptions, orders and audit history stay intact. Removing or
// anonymizing personal fields follows the account-deletion retention policy
// (Backend_architecture.md §14.3; still to be decided).
//
// Foreign keys to users follow that policy:
// - CASCADE: data owned only by the account (credentials, OAuth links, tokens,
//   sessions, role and permission assignments, addresses, carts, notifications,
//   lesson progress).
// - RESTRICT: history and proof of who did what (orders, subscriptions, attempts,
//   decisions, refunds, stock movements, events, audit logs), so an accidental
//   hard delete fails instead of erasing it.
// - SET NULL: incidental metadata only (course and video authorship, invitation
//   acceptor, last settings editor, playback grants, the learner on auth events).
model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @db.VarChar(320)
  normalizedEmail     String     @unique @map("normalized_email") @db.VarChar(320)
  displayName         String     @map("display_name") @db.VarChar(160)
  phone               String?    @db.VarChar(32)
  status              UserStatus @default(ACTIVE)
  emailVerifiedAt     DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletionRequestedAt DateTime?  @map("deletion_requested_at") @db.Timestamptz(6)
  deactivatedAt       DateTime?  @map("deactivated_at") @db.Timestamptz(6)

  credential                   UserCredential?
  oauthAccounts                OAuthAccount[]
  authTokens                   AuthToken[]
  sessions                     UserSession[]
  roles                        UserRole[]                 @relation("UserRoleHolder")
  roleAssignmentsMade          UserRole[]                 @relation("UserRoleAssigner")
  permissionOverrides          UserPermission[]           @relation("UserPermissionHolder")
  permissionGrantsMade         UserPermission[]           @relation("UserPermissionGrantor")
  invitationsSent              AdminInvitation[]          @relation("InvitationInviter")
  invitationsAccepted          AdminInvitation[]          @relation("InvitationAcceptor")
  subscriptionRequests         SubscriptionRequest[]      @relation("SubscriptionRequester")
  subscriptionRequestsReviewed SubscriptionRequest[]      @relation("SubscriptionRequestReviewer")
  subscriptionPeriods          SubscriptionPeriod[]       @relation("SubscriptionPeriodHolder")
  subscriptionPeriodsActivated SubscriptionPeriod[]       @relation("SubscriptionPeriodActivator")
  lessonProgress               LessonProgress[]
  testAttempts                 TestAttempt[]
  playbackSessions             PlaybackSession[]
  addresses                    Address[]
  carts                        Cart[]
  orders                       Order[]
  notifications                Notification[]
  auditEvents                  AuditLog[]                 @relation("AuditActor")
  createdCourses               Course[]                   @relation("CourseCreator")
  createdVideoAssets           VideoAsset[]               @relation("VideoAssetCreator")
  reviewedPaymentSubmissions   PaymentSubmission[]        @relation("PaymentReviewer")
  inventoryMovements           InventoryMovement[]
  cancellationRequests         CancellationRequest[]      @relation("CancellationRequester")
  reviewedCancellations        CancellationRequest[]      @relation("CancellationReviewer")
  returnRequests               ReturnRequest[]            @relation("ReturnRequester")
  reviewedReturns              ReturnRequest[]            @relation("ReturnReviewer")
  createdRefunds               RefundRecord[]             @relation("RefundRecorder")
  authEvents                   AuthEvent[]
  subscriptionRequestEvents    SubscriptionRequestEvent[] @relation("SubscriptionRequestEventActor")
  resultReleaseEvents          ResultReleaseEvent[]       @relation("ResultReleaseActor")
  orderEventsRecorded          OrderEvent[]               @relation("OrderEventActor")
  storeSettingsUpdated         StoreSetting[]             @relation("StoreSettingUpdater")

  @@index([status, createdAt])
  @@map("users")
}

model UserCredential {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credentials")
}

model OAuthAccount {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        OAuthProvider
  providerSubject String        @map("provider_subject") @db.VarChar(255)
  providerEmail   String?       @map("provider_email") @db.VarChar(320)
  emailVerified   Boolean       @default(false) @map("email_verified")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("oauth_accounts")
}

model AuthToken {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  purpose    AuthTokenPurpose
  tokenHash  String           @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
  @@map("auth_tokens")
}

// Express-session's connect-pg-simple store owns its standard `session` table.
// Its schema is created by the store adapter, not by Prisma Migrate.
model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionId  String    @unique @map("session_id") @db.VarChar(255)
  ipHash     String?   @map("ip_hash") @db.VarChar(128)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEvents AuthEvent[]

  @@index([userId, expiresAt])
  @@index([revokedAt, expiresAt])
  @@map("user_sessions")
}

// Security timeline for sign-in, sessions and credentials (Backend_architecture.md
// §7.3, §15.1). Append-only. Never stores passwords, tokens, session IDs, raw email
// addresses or raw IP addresses. userId is null when the submitted email matches
// no account; emailHash (a keyed hash of the normalized email) still lets repeated
// failures against one address be detected. Admin permission and role changes are
// recorded in audit_logs, not here.
model AuthEvent {
  id            String        @id @default(uuid()) @db.Uuid
  type          AuthEventType
  method        AuthMethod?
  userId        String?       @map("user_id") @db.Uuid
  userSessionId String?       @map("user_session_id") @db.Uuid
  emailHash     String?       @map("email_hash") @db.Char(64)
  // Stable code such as INVALID_CREDENTIALS, ACCOUNT_SUSPENDED or RATE_LIMITED.
  failureReason String?       @map("failure_reason") @db.VarChar(80)
  ipHash        String?       @map("ip_hash") @db.VarChar(128)
  userAgent     String?       @map("user_agent") @db.VarChar(512)
  requestId     String?       @map("request_id") @db.VarChar(100)
  metadata      Json?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userSession UserSession? @relation(fields: [userSessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([emailHash, createdAt])
  @@index([type, createdAt])
  @@map("auth_events")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]
  users UserPermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?  @map("assigned_by") @db.Uuid

  user     User  @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role     Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assigner User? @relation("UserRoleAssigner", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String           @map("user_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  grantedById  String?          @map("granted_by_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User       @relation("UserPermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedBy  User?      @relation("UserPermissionGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, permissionId])
  @@index([permissionId, effect])
  @@map("user_permissions")
}

model AdminInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  email           String           @db.VarChar(320)
  normalizedEmail String           @map("normalized_email") @db.VarChar(320)
  tokenHash       String           @unique @map("token_hash") @db.VarChar(255)
  status          InvitationStatus @default(PENDING)
  invitedById     String           @map("invited_by_id") @db.Uuid
  acceptedById    String?          @map("accepted_by_id") @db.Uuid
  expiresAt       DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?        @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  inviter  User  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptor User? @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([normalizedEmail, status])
  @@index([status, expiresAt])
  @@map("admin_invitations")
}

// -----------------------------------------------------------------------------
// COURSE CATALOG AND LEARNING PROGRESS
// -----------------------------------------------------------------------------

model ExamCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(140)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses  CourseExamCategory[]
  tests    TestExamCategory[]
  products Product[]

  @@map("exam_categories")
}

model Subject {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  slug      String   @unique @db.VarChar(140)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  courses      CourseSubject[]
  tests        TestSubject[]
  products     Product[]
  testSections TestVersionSection[]

  @@map("subjects")
}

model Course {
  id                 String       @id @default(uuid()) @db.Uuid
  title              String       @db.VarChar(200)
  slug               String       @unique @db.VarChar(220)
  shortDescription   String?      @map("short_description") @db.VarChar(500)
  description        String?      @db.Text
  thumbnailObjectKey String?      @map("thumbnail_object_key") @db.VarChar(512)
  status             CourseStatus @default(DRAFT)
  previewLessonId    String?      @unique @map("preview_lesson_id") @db.Uuid
  createdById        String?      @map("created_by_id") @db.Uuid
  publishedAt        DateTime?    @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  modules        CourseModule[]
  examCategories CourseExamCategory[]
  subjects       CourseSubject[]
  previewLesson  Lesson?              @relation("CoursePreviewLesson", fields: [previewLessonId], references: [id], onDelete: SetNull)
  tests          TestCourse[]
  createdBy      User?                @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@map("courses")
}

model CourseExamCategory {
  courseId       String @map("course_id") @db.Uuid
  examCategoryId String @map("exam_category_id") @db.Uuid

  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  examCategory ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Restrict)

  @@id([courseId, examCategoryId])
  @@map("course_exam_categories")
}

model CourseSubject {
  courseId  String @map("course_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([courseId, subjectId])
  @@map("course_subjects")
}

model CourseModule {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, sortOrder])
  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id                 String       @id @default(uuid()) @db.Uuid
  moduleId           String       @map("module_id") @db.Uuid
  title              String       @db.VarChar(200)
  description        String?      @db.Text
  sortOrder          Int          @map("sort_order")
  status             LessonStatus @default(DRAFT)
  activeVideoAssetId String?      @unique @map("active_video_asset_id") @db.Uuid
  publishedAt        DateTime?    @map("published_at") @db.Timestamptz(6)
  archivedAt         DateTime?    @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  module           CourseModule      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  previewForCourse Course?           @relation("CoursePreviewLesson")
  activeVideoAsset VideoAsset?       @relation("ActiveLessonVideo", fields: [activeVideoAssetId], references: [id], onDelete: SetNull)
  videoAssets      VideoAsset[]      @relation("LessonVideoVersions")
  resources        LessonResource[]
  progress         LessonProgress[]
  playbackSessions PlaybackSession[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId, status])
  @@map("lessons")
}

model LessonResource {
  id          String             @id @default(uuid()) @db.Uuid
  lessonId    String             @map("lesson_id") @db.Uuid
  type        LessonResourceType
  title       String             @db.VarChar(200)
  description String?            @db.Text
  objectKey   String?            @map("object_key") @db.VarChar(512)
  externalUrl String?            @map("external_url") @db.VarChar(2048)
  mimeType    String?            @map("mime_type") @db.VarChar(150)
  sizeBytes   BigInt?            @map("size_bytes")
  isPublished Boolean            @default(false) @map("is_published")
  sortOrder   Int                @default(0) @map("sort_order")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, isPublished, sortOrder])
  @@map("lesson_resources")
}

model LessonProgress {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  lessonId         String    @map("lesson_id") @db.Uuid
  lastVideoAssetId String?   @map("last_video_asset_id") @db.Uuid
  positionMs       BigInt    @default(0) @map("position_ms")
  durationMs       BigInt?   @map("duration_ms")
  percentComplete  Decimal   @default(0) @map("percent_complete") @db.Decimal(5, 2)
  completedAt      DateTime? @map("completed_at") @db.Timestamptz(6)
  lastWatchedAt    DateTime? @map("last_watched_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lastVideoAsset VideoAsset? @relation("ProgressVideoAsset", fields: [lastVideoAssetId], references: [id], onDelete: SetNull)

  @@unique([userId, lessonId])
  @@index([userId, lastWatchedAt])
  @@map("lesson_progress")
}

// -----------------------------------------------------------------------------
// SUBSCRIPTIONS AND ENTITLEMENTS
// -----------------------------------------------------------------------------

model SubscriptionPlan {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  durationDays Int      @map("duration_days")
  pricePaise   BigInt   @map("price_paise")
  currency     String   @default("INR") @db.Char(3)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  requests SubscriptionRequest[]
  periods  SubscriptionPeriod[]

  @@index([isActive, sortOrder])
  @@map("subscription_plans")
}

model SubscriptionRequest {
  id                    String                    @id @default(uuid()) @db.Uuid
  userId                String                    @map("user_id") @db.Uuid
  planId                String                    @map("plan_id") @db.Uuid
  status                SubscriptionRequestStatus @default(PENDING)
  requestedDurationDays Int                       @map("requested_duration_days")
  priceSnapshotPaise    BigInt                    @map("price_snapshot_paise")
  currency              String                    @default("INR") @db.Char(3)
  paymentMethod         PaymentMethod             @map("payment_method")
  amountPaidPaise       BigInt                    @map("amount_paid_paise")
  transactionReference  String                    @map("transaction_reference") @db.VarChar(160)
  evidenceObjectKey     String?                   @map("evidence_object_key") @db.VarChar(512)
  submittedAt           DateTime                  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedById          String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt            DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason       String?                   @map("rejection_reason") @db.Text
  createdAt             DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User                       @relation("SubscriptionRequester", fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  reviewer User?                      @relation("SubscriptionRequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  period   SubscriptionPeriod?
  events   SubscriptionRequestEvent[]

  @@index([userId, status, submittedAt])
  @@index([status, submittedAt])
  @@map("subscription_requests")
}

// Status history of a subscription request: submitted, approved, rejected or
// cancelled, with who did it and why (Backend_architecture.md §7.3, §10.1).
// Append-only; subscription_requests holds the current state. fromStatus is null
// for the submission event. Written in the same transaction as the status change.
model SubscriptionRequestEvent {
  id          String                     @id @default(uuid()) @db.Uuid
  requestId   String                     @map("request_id") @db.Uuid
  fromStatus  SubscriptionRequestStatus? @map("from_status")
  toStatus    SubscriptionRequestStatus  @map("to_status")
  actorUserId String?                    @map("actor_user_id") @db.Uuid
  reason      String?                    @db.Text
  metadata    Json?
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)

  request SubscriptionRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  actor   User?               @relation("SubscriptionRequestEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("subscription_request_events")
}

model SubscriptionPeriod {
  id               String                   @id @default(uuid()) @db.Uuid
  userId           String                   @map("user_id") @db.Uuid
  planId           String                   @map("plan_id") @db.Uuid
  sourceRequestId  String?                  @unique @map("source_request_id") @db.Uuid
  status           SubscriptionPeriodStatus @default(ACTIVE)
  startsAt         DateTime                 @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime                 @map("ends_at") @db.Timestamptz(6)
  activatedById    String?                  @map("activated_by_id") @db.Uuid
  revokedAt        DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revocationReason String?                  @map("revocation_reason") @db.Text
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User                 @relation("SubscriptionPeriodHolder", fields: [userId], references: [id], onDelete: Restrict)
  plan          SubscriptionPlan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  sourceRequest SubscriptionRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)
  activatedBy   User?                @relation("SubscriptionPeriodActivator", fields: [activatedById], references: [id], onDelete: Restrict)

  @@index([userId, status, startsAt, endsAt])
  @@map("subscription_periods")
}

// -----------------------------------------------------------------------------
// VIDEO ASSETS, UPLOADS, PROCESSING AND PLAYBACK
// -----------------------------------------------------------------------------

model VideoAsset {
  id                   String           @id @default(uuid()) @db.Uuid
  lessonId             String           @map("lesson_id") @db.Uuid
  versionNumber        Int              @map("version_number")
  status               VideoAssetStatus @default(UPLOAD_PENDING)
  originalFilename     String           @map("original_filename") @db.VarChar(255)
  sourceContentType    String           @map("source_content_type") @db.VarChar(150)
  sourceSizeBytes      BigInt           @map("source_size_bytes")
  sourceSha256         String?          @map("source_sha256") @db.Char(64)
  intakeBucket         String           @map("intake_bucket") @db.VarChar(120)
  intakeObjectKey      String           @unique @map("intake_object_key") @db.VarChar(512)
  archiveProvider      String?          @map("archive_provider") @db.VarChar(80)
  archiveBucket        String?          @map("archive_bucket") @db.VarChar(120)
  archiveObjectKey     String?          @unique @map("archive_object_key") @db.VarChar(512)
  archiveSha256        String?          @map("archive_sha256") @db.Char(64)
  archivedAt           DateTime?        @map("archived_at") @db.Timestamptz(6)
  durationMs           BigInt?          @map("duration_ms")
  width                Int?
  height               Int?
  frameRateNumerator   Int?             @map("frame_rate_numerator")
  frameRateDenominator Int?             @map("frame_rate_denominator")
  sourceVideoCodec     String?          @map("source_video_codec") @db.VarChar(80)
  sourceAudioCodec     String?          @map("source_audio_codec") @db.VarChar(80)
  createdById          String?          @map("created_by_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson           Lesson               @relation("LessonVideoVersions", fields: [lessonId], references: [id], onDelete: Restrict)
  activeForLesson  Lesson?              @relation("ActiveLessonVideo")
  createdBy        User?                @relation("VideoAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  uploadSessions   VideoUploadSession[]
  processingJobs   VideoProcessingJob[]
  hlsPackages      HlsPackage[]
  playbackSessions PlaybackSession[]
  progressRecords  LessonProgress[]     @relation("ProgressVideoAsset")

  @@unique([lessonId, versionNumber])
  @@index([lessonId, status])
  @@index([status, createdAt])
