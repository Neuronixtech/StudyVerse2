model Product {
  id                String        @id @default(uuid()) @db.Uuid
  sku               String        @unique @db.VarChar(80)
  slug              String        @unique @db.VarChar(220)
  title             String        @db.VarChar(240)
  author            String?       @db.VarChar(180)
  publisher         String?       @db.VarChar(180)
  isbn              String?       @db.VarChar(32)
  edition           String?       @db.VarChar(100)
  language          String?       @db.VarChar(80)
  description       String?       @db.Text
  examCategoryId    String?       @map("exam_category_id") @db.Uuid
  subjectId         String?       @map("subject_id") @db.Uuid
  mrpPaise          BigInt        @map("mrp_paise")
  sellingPricePaise BigInt        @map("selling_price_paise")
  currency          String        @default("INR") @db.Char(3)
  status            ProductStatus @default(DRAFT)
  publishedAt       DateTime?     @map("published_at") @db.Timestamptz(6)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  examCategory ExamCategory?       @relation(fields: [examCategoryId], references: [id], onDelete: SetNull)
  subject      Subject?            @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  images       ProductImage[]
