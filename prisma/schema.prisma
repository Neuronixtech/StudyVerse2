}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  courierName    String?        @map("courier_name") @db.VarChar(120)
  trackingNumber String?        @map("tracking_number") @db.VarChar(120)
  status         ShipmentStatus @default(PROCESSING)
