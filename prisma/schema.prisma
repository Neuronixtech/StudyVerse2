  @@index([userId, isDefault])
  @@map("addresses")
}

// A cart belongs to a learner or to an anonymous visitor's cookie token (CHECK in
// extra-constraints.sql). Partial unique indexes allow one ACTIVE cart per learner
// and per guest token. The guest token is deliberately not unique on its own: the
// same browser must be able to start a new cart after an earlier one is merged,
// converted or abandoned. On sign-in the guest cart is merged into the learner's
// active cart (created if needed) and marked MERGED; it is never re-owned or deleted.
// See "Guest cart merge" in prisma/README.md (BOOKSTORE_SPEC §3.2).
model Cart {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String?    @map("user_id") @db.Uuid
  guestTokenHash   String?    @map("guest_token_hash") @db.VarChar(255)
  status           CartStatus @default(ACTIVE)
  // Set with status MERGED: the learner cart this guest cart was folded into.
  mergedIntoCartId String?    @map("merged_into_cart_id") @db.Uuid
  expiresAt        DateTime?  @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mergedInto  Cart?      @relation("CartMerge", fields: [mergedIntoCartId], references: [id], onDelete: Restrict)
  mergedCarts Cart[]     @relation("CartMerge")
  items       CartItem[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  orderNumber       String      @unique @map("order_number") @db.VarChar(40)
  userId            String      @map("user_id") @db.Uuid
  addressId         String?     @map("address_id") @db.Uuid
  status            OrderStatus @default(PENDING_PAYMENT)
  currency          String      @default("INR") @db.Char(3)
  itemSubtotalPaise BigInt      @map("item_subtotal_paise")
  shippingPaise     BigInt      @map("shipping_paise")
  discountPaise     BigInt      @default(0) @map("discount_paise")
  totalPaise        BigInt      @map("total_paise")
  addressSnapshot   Json        @map("address_snapshot")
  placedAt          DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  processingAt      DateTime?   @map("processing_at") @db.Timestamptz(6)
  shippedAt         DateTime?   @map("shipped_at") @db.Timestamptz(6)
  deliveredAt       DateTime?   @map("delivered_at") @db.Timestamptz(6)
  cancelledAt       DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  address              Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  reservations         StockReservation[]
  paymentSubmissions   PaymentSubmission[]
  shipments            Shipment[]
  events               OrderEvent[]
  cancellationRequests CancellationRequest[]
  returnRequests       ReturnRequest[]
  refunds              RefundRecord[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  skuSnapshot      String  @map("sku_snapshot") @db.VarChar(80)
  titleSnapshot    String  @map("title_snapshot") @db.VarChar(240)
  editionSnapshot  String? @map("edition_snapshot") @db.VarChar(100)
  languageSnapshot String? @map("language_snapshot") @db.VarChar(80)
  mrpPaiseSnapshot BigInt  @map("mrp_paise_snapshot")
  unitPricePaise   BigInt  @map("unit_price_paise")
  quantity         Int
  lineTotalPaise   BigInt  @map("line_total_paise")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId])
  @@map("order_items")
}

model PaymentSubmission {
  id                   String                  @id @default(uuid()) @db.Uuid
  orderId              String                  @map("order_id") @db.Uuid
  method               PaymentMethod
  amountPaise          BigInt                  @map("amount_paise")
  transactionReference String                  @map("transaction_reference") @db.VarChar(160)
  screenshotObjectKey  String?                 @map("screenshot_object_key") @db.VarChar(512)
  status               PaymentSubmissionStatus @default(SUBMITTED)
  submittedAt          DateTime                @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedById         String?                 @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?               @map("reviewed_at") @db.Timestamptz(6)
