model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  actorType   AuditActorType @default(USER) @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  action      String         @db.VarChar(160)
  targetType  String         @map("target_type") @db.VarChar(100)
  targetId    String?        @map("target_id") @db.VarChar(100)
  metadata    Json?
  requestId   String?        @map("request_id") @db.VarChar(100)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// Request idempotency keys (Backend_architecture.md §9.6). A key is scoped to one
// operation (for example "orders.create") and one actor: actorKey is "user:<uuid>",
// "guest:<token hash>" or "system:<name>". The request starts by inserting an
// IN_PROGRESS row; a concurrent duplicate hits the unique constraint. On success,
// or on a deterministic 4xx, the row becomes COMPLETED with the response status and
// a reference to the resulting resource, so replays return the same outcome. On a
// retryable failure the row is deleted. A different request body under the same
// key (requestHash mismatch) is a 409 conflict. lockedUntil lets a crashed request's
// row be taken over; expiresAt drives cleanup. responseBody is optional and must
// never contain secrets or tokens.
model IdempotencyRecord {
  id             String            @id @default(uuid()) @db.Uuid
  operation      String            @db.VarChar(100)
  actorKey       String            @map("actor_key") @db.VarChar(160)
  idempotencyKey String            @map("idempotency_key") @db.VarChar(255)
  // SHA-256 hex of the canonicalized request body.
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus @default(IN_PROGRESS)
  responseStatus Int?              @map("response_status")
  resourceType   String?           @map("resource_type") @db.VarChar(100)
  resourceId     String?           @map("resource_id") @db.VarChar(100)
  responseBody   Json?             @map("response_body")
  lockedUntil    DateTime          @map("locked_until") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)

  @@unique([operation, actorKey, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}
