  requester User  @relation("CancellationRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewer  User? @relation("CancellationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([orderId, requestedAt])
