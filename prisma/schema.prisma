// StudyVerse initial production data model.
// Prisma ORM 7.x schema. Database URLs are configured in apps/api/prisma.config.ts.
// Review this schema before applying the first production migration.

generator client {
  provider            = "prisma-client"
  output              = "../apps/api/src/generated/prisma"
  // The API is native ESM (NestJS 12, "module": "nodenext"): relative imports in
  // the generated TypeScript need explicit .js extensions to run under Node.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

// ACTIVE: can sign in. SUSPENDED: blocked by an admin, reversible.
// PENDING_DELETION: the user asked to delete the account. DEACTIVATED: the account
// is closed (soft-deleted): sign-in is blocked and history is kept.
enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DEACTIVATED
}

