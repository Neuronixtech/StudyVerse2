}

model VideoUploadSession {
  id                String                   @id @default(uuid()) @db.Uuid
  videoAssetId      String                   @map("video_asset_id") @db.Uuid
  providerUploadId  String?                  @unique @map("provider_upload_id") @db.VarChar(255)
  objectKey         String                   @unique @map("object_key") @db.VarChar(512)
  status            VideoUploadSessionStatus @default(INITIATED)
  expectedSizeBytes BigInt                   @map("expected_size_bytes")
  actualSizeBytes   BigInt?                  @map("actual_size_bytes")
  expiresAt         DateTime                 @map("expires_at") @db.Timestamptz(6)
  completedAt       DateTime?                @map("completed_at") @db.Timestamptz(6)
  abortedAt         DateTime?                @map("aborted_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  videoAsset VideoAsset        @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  parts      VideoUploadPart[]

  @@index([status, expiresAt])
  @@map("video_upload_sessions")
}

model VideoUploadPart {
  id              String   @id @default(uuid()) @db.Uuid
  uploadSessionId String   @map("upload_session_id") @db.Uuid
  partNumber      Int      @map("part_number")
  etag            String   @db.VarChar(255)
  sizeBytes       BigInt   @map("size_bytes")
  uploadedAt      DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  uploadSession VideoUploadSession @relation(fields: [uploadSessionId], references: [id], onDelete: Cascade)

  @@unique([uploadSessionId, partNumber])
  @@map("video_upload_parts")
}

model VideoProcessingJob {
  id               String                   @id @default(uuid()) @db.Uuid
  videoAssetId     String                   @map("video_asset_id") @db.Uuid
  status           VideoProcessingJobStatus @default(QUEUED)
  stage            VideoProcessingStage     @default(VALIDATE_SOURCE)
  progressPercent  Int                      @default(0) @map("progress_percent")
  attempts         Int                      @default(0)
  maxAttempts      Int                      @default(4) @map("max_attempts")
  availableAt      DateTime                 @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner       String?                  @map("lease_owner") @db.VarChar(160)
  leaseExpiresAt   DateTime?                @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt      DateTime?                @map("heartbeat_at") @db.Timestamptz(6)
  idempotencyKey   String                   @unique @map("idempotency_key") @db.VarChar(255)
  lastErrorCode    String?                  @map("last_error_code") @db.VarChar(100)
  lastErrorMessage String?                  @map("last_error_message") @db.Text
  startedAt        DateTime?                @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?                @map("finished_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  videoAsset     VideoAsset               @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  attemptHistory VideoProcessingAttempt[]

  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
  @@index([videoAssetId, createdAt])
  @@map("video_processing_jobs")
}

model VideoProcessingAttempt {
  id             String                   @id @default(uuid()) @db.Uuid
  jobId          String                   @map("job_id") @db.Uuid
  attemptNumber  Int                      @map("attempt_number")
  stage          VideoProcessingStage
  outcome        ProcessingAttemptOutcome @default(RUNNING)
  workerId       String?                  @map("worker_id") @db.VarChar(160)
  encoderVersion String?                  @map("encoder_version") @db.VarChar(120)
  ffmpegExitCode Int?                     @map("ffmpeg_exit_code")
  errorCode      String?                  @map("error_code") @db.VarChar(100)
  errorMessage   String?                  @map("error_message") @db.Text
  logObjectKey   String?                  @map("log_object_key") @db.VarChar(512)
  startedAt      DateTime                 @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?                @map("finished_at") @db.Timestamptz(6)

  job VideoProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNumber])
  @@index([outcome, startedAt])
  @@map("video_processing_attempts")
}

model HlsPackage {
  id                String           @id @default(uuid()) @db.Uuid
  videoAssetId      String           @map("video_asset_id") @db.Uuid
  profileVersion    String           @map("profile_version") @db.VarChar(80)
  status            HlsPackageStatus @default(STAGING)
  masterPlaylistKey String           @map("master_playlist_key") @db.VarChar(512)
  totalSizeBytes    BigInt?          @map("total_size_bytes")
  verifiedAt        DateTime?        @map("verified_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  videoAsset VideoAsset       @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)
  renditions VideoRendition[]

  @@unique([videoAssetId, profileVersion])
  @@index([status, createdAt])
  @@map("hls_packages")
}

model VideoRendition {
  id            String    @id @default(uuid()) @db.Uuid
  hlsPackageId  String    @map("hls_package_id") @db.Uuid
  name          String    @db.VarChar(32)
  width         Int
  height        Int
  videoCodec    String    @map("video_codec") @db.VarChar(80)
  audioCodec    String?   @map("audio_codec") @db.VarChar(80)
  targetBitrate Int       @map("target_bitrate")
  playlistKey   String    @unique @map("playlist_key") @db.VarChar(512)
  segmentCount  Int       @map("segment_count")
  sizeBytes     BigInt    @map("size_bytes")
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  hlsPackage HlsPackage @relation(fields: [hlsPackageId], references: [id], onDelete: Cascade)

  @@unique([hlsPackageId, name])
  @@map("video_renditions")
}

model PlaybackSession {
  id           String             @id @default(uuid()) @db.Uuid
  grantIdHash  String             @unique @map("grant_id_hash") @db.VarChar(255)
  userId       String?            @map("user_id") @db.Uuid
  lessonId     String             @map("lesson_id") @db.Uuid
  videoAssetId String             @map("video_asset_id") @db.Uuid
  accessType   PlaybackAccessType @map("access_type")
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([lessonId, createdAt])
  @@index([videoAssetId, expiresAt])
  @@map("playback_sessions")
}

// -----------------------------------------------------------------------------
// ASSESSMENTS, TEST VERSIONS AND ATTEMPTS
// -----------------------------------------------------------------------------

model Test {
  id              String     @id @default(uuid()) @db.Uuid
  title           String     @db.VarChar(200)
  slug            String     @unique @db.VarChar(220)
  description     String?    @db.Text
  // Required, no default: every test is classified explicitly when it's created.
  kind            TestKind
  status          TestStatus @default(DRAFT)
  isFreeDemo      Boolean    @default(false) @map("is_free_demo")
  activeVersionId String?    @unique @map("active_version_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt      DateTime?  @map("archived_at") @db.Timestamptz(6)

  versions       TestVersion[]
  activeVersion  TestVersion?       @relation("ActiveTestVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  examCategories TestExamCategory[]
  subjects       TestSubject[]
  courses        TestCourse[]
  attempts       TestAttempt[]

  @@index([status, createdAt])
  @@map("tests")
}

model TestExamCategory {
  testId         String @map("test_id") @db.Uuid
  examCategoryId String @map("exam_category_id") @db.Uuid

  test         Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  examCategory ExamCategory @relation(fields: [examCategoryId], references: [id], onDelete: Restrict)

  @@id([testId, examCategoryId])
  @@map("test_exam_categories")
}

model TestSubject {
  testId    String @map("test_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([testId, subjectId])
  @@map("test_subjects")
}

model TestCourse {
  testId   String @map("test_id") @db.Uuid
  courseId String @map("course_id") @db.Uuid

  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([testId, courseId])
  @@map("test_courses")
}

model TestVersion {
  id                    String            @id @default(uuid()) @db.Uuid
  testId                String            @map("test_id") @db.Uuid
  versionNumber         Int               @map("version_number")
  status                TestVersionStatus @default(DRAFT)
  timingMode            TestTimingMode    @map("timing_mode")
  durationSeconds       Int               @map("duration_seconds")
  attemptLimit          Int?              @map("attempt_limit")
  markingConfig         Json              @map("marking_config")
  resultReleaseMode     ResultReleaseMode @default(IMMEDIATE) @map("result_release_mode")
  answerReviewReleaseAt DateTime?         @map("answer_review_release_at") @db.Timestamptz(6)
  publishedAt           DateTime?         @map("published_at") @db.Timestamptz(6)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  test          Test                  @relation(fields: [testId], references: [id], onDelete: Restrict)
  activeForTest Test?                 @relation("ActiveTestVersion")
  sections      TestVersionSection[]
  questions     TestVersionQuestion[]
  attempts      TestAttempt[]
  releaseEvents ResultReleaseEvent[]

  @@unique([testId, versionNumber])
  @@index([testId, status])
  @@map("test_versions")
}

// History of admin decisions to release or withhold detailed solutions (answer
// review) for a test version (Backend_architecture.md §7.3, §10.3). The version's
// answerReviewReleaseAt holds the current state: set when released, null when
// withheld. Written in the same transaction as that change. Scores are always
// shown on submission; only the answer review is gated.
model ResultReleaseEvent {
  id            String              @id @default(uuid()) @db.Uuid
  testVersionId String              @map("test_version_id") @db.Uuid
  action        ResultReleaseAction
  actorUserId   String?             @map("actor_user_id") @db.Uuid
  reason        String?             @db.Text
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  testVersion TestVersion @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  actor       User?       @relation("ResultReleaseActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([testVersionId, createdAt])
  @@map("result_release_events")
}

// A section of one test version: its order, title, optional subject, instructions
// and, for section-timed tests (timingMode SECTION), its own time budget. Sections
// belong to a version, so a published version's sections are frozen with it and a
// draft version's sections are the editable configuration (PLAN.md §6.2-6.5).
// A test may also have no sections; its questions then have no sectionId.
// subjectNameSnapshot is the subject's name when the version was published, copied by
// a trigger at publication (extra-constraints.sql) and frozen with the version, so
// renaming a subject never relabels a published test. Drafts leave it null and show
// the current name: label = COALESCE(subjectNameSnapshot, subject.name).
model TestVersionSection {
  id                  String  @id @default(uuid()) @db.Uuid
  testVersionId       String  @map("test_version_id") @db.Uuid
  subjectId           String? @map("subject_id") @db.Uuid
  subjectNameSnapshot String? @map("subject_name_snapshot") @db.VarChar(120)
  title               String  @db.VarChar(160)
  instructions        String? @db.Text
  sortOrder           Int     @map("sort_order")
  durationSeconds     Int?    @map("duration_seconds")

  testVersion   TestVersion           @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  subject       Subject?              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  questions     TestVersionQuestion[]
  attemptStates AttemptSectionState[]

  @@unique([testVersionId, sortOrder])
  // Referenced by the composite foreign key on test_version_questions that keeps a
  // question's section inside the question's own version.
  @@unique([id, testVersionId])
  @@map("test_version_sections")
}

model QuestionBankItem {
  id          String       @id @default(uuid()) @db.Uuid
  type        QuestionType
  prompt      Json
  explanation Json?
  difficulty  String?      @db.VarChar(40)
  isArchived  Boolean      @default(false) @map("is_archived")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  options          QuestionBankOption[]
  versionSnapshots TestVersionQuestion[]

  @@index([type, isArchived])
  @@map("question_bank_items")
}

model QuestionBankOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  content    Json
  isCorrect  Boolean  @default(false) @map("is_correct")
  sortOrder  Int      @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  question QuestionBankItem @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
  @@index([questionId])
  @@map("question_bank_options")
}

model TestVersionQuestion {
  id                  String       @id @default(uuid()) @db.Uuid
  testVersionId       String       @map("test_version_id") @db.Uuid
  sectionId           String?      @map("section_id") @db.Uuid
  sourceQuestionId    String?      @map("source_question_id") @db.Uuid
  questionOrder       Int          @map("question_order")
  type                QuestionType
  promptSnapshot      Json         @map("prompt_snapshot")
  optionsSnapshot     Json?        @map("options_snapshot")
  answerKeySnapshot   Json         @map("answer_key_snapshot")
  markingSnapshot     Json         @map("marking_snapshot")
  explanationSnapshot Json?        @map("explanation_snapshot")

  testVersion    TestVersion            @relation(fields: [testVersionId], references: [id], onDelete: Cascade)
  // Composite key: the section must belong to this question's version. NO ACTION:
  // a section that still has questions can't be deleted (move or delete them
  // first); deleting a whole draft version still cascades to both.
  section        TestVersionSection?    @relation(fields: [sectionId, testVersionId], references: [id, testVersionId], onDelete: NoAction)
  sourceQuestion QuestionBankItem?      @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  attemptStates  AttemptQuestionState[]

  @@unique([testVersionId, questionOrder])
  @@index([sectionId, questionOrder])
  @@index([sourceQuestionId])
  @@map("test_version_questions")
}

// Exactly one actor per attempt: a learner (userId) or an anonymous visitor
// (guestTokenHash, the hash of the visitor's cookie token), enforced by a CHECK in
// extra-constraints.sql. Visitors may retake the free demo like learners do
// (PLAN.md §6.5: unlimited attempts by default), so the guest token is not unique.
// Attempts are numbered per actor and test. Associating a guest attempt with a
// learner on sign-in sets userId, clears guestTokenHash and renumbers it after the
// learner's existing attempts, in one transaction.
model TestAttempt {
  id                   String        @id @default(uuid()) @db.Uuid
  testId               String        @map("test_id") @db.Uuid
  testVersionId        String        @map("test_version_id") @db.Uuid
  userId               String?       @map("user_id") @db.Uuid
  guestTokenHash       String?       @map("guest_token_hash") @db.VarChar(255)
  guestFingerprintHash String?       @map("guest_fingerprint_hash") @db.VarChar(255)
  status               AttemptStatus @default(IN_PROGRESS)
  attemptNumber        Int           @map("attempt_number")
  startedAt            DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt            DateTime      @map("expires_at") @db.Timestamptz(6)
  submittedAt          DateTime?     @map("submitted_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  test          Test                   @relation(fields: [testId], references: [id], onDelete: Restrict)
  testVersion   TestVersion            @relation(fields: [testVersionId], references: [id], onDelete: Restrict)
  // RESTRICT, not SET NULL: SET NULL would leave an attempt with no actor, which the
  // exactly-one-actor CHECK forbids. Learners are deactivated, never deleted.
  user          User?                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  states        AttemptQuestionState[]
  sectionStates AttemptSectionState[]
  result        AttemptResult?

  @@unique([userId, testId, attemptNumber])
  @@unique([guestTokenHash, testId, attemptNumber])
  @@index([userId, testId, startedAt])
  @@index([guestTokenHash, testId, startedAt])
  @@index([testVersionId, status])
  @@index([status, expiresAt])
  @@map("test_attempts")
}

model AttemptQuestionState {
  id                    String    @id @default(uuid()) @db.Uuid
  attemptId             String    @map("attempt_id") @db.Uuid
  testVersionQuestionId String    @map("test_version_question_id") @db.Uuid
  visitedAt             DateTime? @map("visited_at") @db.Timestamptz(6)
  answer                Json?
  answeredAt            DateTime? @map("answered_at") @db.Timestamptz(6)
  markedForReview       Boolean   @default(false) @map("marked_for_review")
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt      TestAttempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion TestVersionQuestion @relation(fields: [testVersionQuestionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, testVersionQuestionId])
  @@index([attemptId, markedForReview])
  @@map("attempt_question_states")
}

// Server-side timer and lock state of one section within one attempt, for
// section-timed tests. The server, not the browser, owns attempt timing
// (Backend_architecture.md §10.3); an expired section becomes inaccessible
// (PLAN.md §6.3). activeSince is set while this is the learner's current section;
// elapsedMs is the time used in earlier visits; lockedAt is set when the section
// closes (time used up, or the navigation policy closes it). Remaining time is
// durationSeconds * 1000 - elapsedMs - (now - activeSince). This supports either
// navigation policy left open by deferred decision 4 (revisit or not).
// The section must belong to the attempt's test version (checked in the
// assessments service, as for attempt_question_states).
model AttemptSectionState {
  id             String    @id @default(uuid()) @db.Uuid
  attemptId      String    @map("attempt_id") @db.Uuid
  sectionId      String    @map("section_id") @db.Uuid
  firstEnteredAt DateTime? @map("first_entered_at") @db.Timestamptz(6)
  activeSince    DateTime? @map("active_since") @db.Timestamptz(6)
  elapsedMs      BigInt    @default(0) @map("elapsed_ms")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  attempt TestAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section TestVersionSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, sectionId])
  @@map("attempt_section_states")
}

model AttemptResult {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @unique @map("attempt_id") @db.Uuid
  score            Decimal  @db.Decimal(10, 2)
  maximumScore     Decimal  @map("maximum_score") @db.Decimal(10, 2)
  correctCount     Int      @map("correct_count")
  incorrectCount   Int      @map("incorrect_count")
  unattemptedCount Int      @map("unattempted_count")
  breakdown        Json?
  calculatedAt     DateTime @default(now()) @map("calculated_at") @db.Timestamptz(6)

  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("attempt_results")
}

