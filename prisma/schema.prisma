model StoreSetting {
  key         String   @id @db.VarChar(120)
  value       Json
  description String?  @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedById String?  @map("updated_by_id") @db.Uuid

  updatedBy User? @relation("StoreSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("store_settings")
}

// -----------------------------------------------------------------------------
// NOTIFICATIONS, OUTBOX AND AUDIT
