  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requester User           @relation("ReturnRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewer  User?          @relation("ReturnReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  refunds   RefundRecord[]

  @@index([status, requestedAt])
  @@index([orderId, requestedAt])
  @@map("return_requests")
